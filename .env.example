# Copy to .env and fill in. Never commit .env.
# Server-side TomTom key (Routing API and Search API). Not exposed to the browser.
TOMTOM_API_KEY=
# Django
DJANGO_SECRET_KEY=
# 1 only on your own machine. With 1, an unexpected error outside the API answers with Django's
# debug page (settings, source paths). The API itself always answers in JSON.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Deployment only: the number of proxies in front of the app (1 on most hosts), so the request
# limits count the real client address. Leave unset locally.
# DJANGO_NUM_PROXIES=1
# Frontend (Vite): a separate, map-only TomTom key (see CLAUDE.md section 7)
# Put this in frontend/.env.local as VITE_TOMTOM_MAP_KEY=
