# Copy to .env and fill in. Never commit .env.
# Server-side TomTom key (Routing + Geocoding). Not exposed to the browser.
TOMTOM_API_KEY=
# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend (Vite) — map-only TomTom key with a domain whitelist (see CLAUDE.md section 7)
# Put this in frontend/.env.local as VITE_TOMTOM_MAP_KEY=
